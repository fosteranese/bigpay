                <TablixCell>
                  <CellContents>
                    <Textbox Name="Textbox8">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=FormatCurrency(Math.Abs((CDbl(IIf(IsNothing(Fields!OPENINGBALANCE.Value), 0, Fields!OPENINGBALANCE.Value)) + Sum(IIf(Fields!FUNCTIONDESC.Value = "Buy Cash From Central Bank", CDbl(Fields!AMOUNT.Value), 0.0)) - Sum(IIf(Fields!FUNCTIONDESC.Value = "Sell Cash to Central Bank", CDbl(Fields!AMOUNT.Value), 0.0)) - Sum(IIf(Not(Fields!FUNCTIONDESC.Value = "Sell Cash to Central Bank") And Not(Fields!FUNCTIONDESC.Value = "Buy Cash From Central Bank") And Not(Fields!FUNCTIONDESC.Value = "Transfer Cash to Vault"), CDbl(Fields!AMOUNT.Value), 0.0)) + Sum(IIf(Fields!FUNCTIONDESC.Value = "Transfer Cash to Vault", CDbl(Fields!AMOUNT.Value), 0.0))) / CDbl(IIf(IsNothing(Fields!DENOMINATION_VALUE.Value) Or Fields!DENOMINATION_VALUE.Value = 0, 1, Fields!DENOMINATION_VALUE.Value)))).Replace("$","").Replace("¢","")</Value>
                              <Style>
                                <FontFamily>Tahoma</FontFamily>
                                <FontWeight>Bold</FontWeight>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style>
                            <TextAlign>Center</TextAlign>
                          </Style>
                        </Paragraph>
                      </Paragraphs>
