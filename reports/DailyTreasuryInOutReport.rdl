                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=IIf(Fields!FUNCTIONDESC.Value="Sell Cash to Central Bank","TO CENTRAL",IIf(Fields!FUNCTIONDESC.Value="Buy Cash From Central Bank","FROM CENTRAL",IIf(Fields!FUNCTIONDESC.Value="Transfer Cash to Vault","TO VAULT","FROM VAULT")))</Value>
                              <Style>
                                <FontFamily>Tahoma</FontFamily>
                                <FontSize>9pt</FontSize>
